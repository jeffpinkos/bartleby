{
  "name": "bartleby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && concurrently --kill-others -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/check-node.mjs && node --env-file=.env --import tsx --watch server/index.ts",
    "dev:web": "node scripts/check-node.mjs && vite",
    "typecheck": "node scripts/check-node.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "build": "node scripts/check-node.mjs && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/check-node.mjs && node --env-file=.env dist/server/server/index.js",
    "db:migrate": "node scripts/check-node.mjs && node --env-file=.env --import tsx scripts/migrate.ts",
    "test": "node scripts/check-node.mjs && node --env-file=.env --import tsx --test server/*.test.ts",
    "test:e2e": "node scripts/check-node.mjs && npm run build && playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  }
}
